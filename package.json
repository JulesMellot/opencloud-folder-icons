{
  "name": "web-app-folder-icons",
  "version": "0.2.0",
  "private": true,
  "description": "Customize folder icons in OpenCloud Web: icon catalog, colors and custom PNG/ICO images",
  "license": "AGPL-3.0",
  "author": "Jules Mellot",
  "homepage": "https://github.com/JulesMellot/opencloud-folder-icons",
  "repository": {
    "type": "git",
    "url": "https://github.com/JulesMellot/opencloud-folder-icons"
  },
  "type": "module",
  "scripts": {
    "build": "vite build",
    "build:w": "vite build --watch --mode development",
    "check:types": "vue-tsc --noEmit",
    "lint": "eslint 'src/**/*.{ts,vue}' 'tests/**/*.ts' --color",
    "format:check": "prettier . --check",
    "format:write": "prettier . --write",
    "test:unit": "NODE_OPTIONS=--unhandled-rejections=throw vitest --watch=false"
  },
  "devDependencies": {
    "@opencloud-eu/eslint-config": "^8.1.0",
    "@opencloud-eu/extension-sdk": "^8.1.0",
    "@opencloud-eu/prettier-config": "^8.1.0",
    "@opencloud-eu/tsconfig": "^8.1.0",
    "@opencloud-eu/web-client": "^8.1.0",
    "@opencloud-eu/web-pkg": "^8.1.0",
    "@opencloud-eu/web-test-helpers": "^8.1.0",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^10.1.0",
    "happy-dom": "^20.0.0",
    "pinia": "^4.0.3",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.3",
    "vitest": "^5.0.0",
    "vitest-mock-extended": "^5.0.0",
    "vue": "^3.5.31",
    "vue-tsc": "^3.2.6",
    "vue3-gettext": "4.0.1"
  },
  "packageManager": "pnpm@11.28.5"
}
